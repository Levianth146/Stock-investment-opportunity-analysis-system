__pycache__/
*.pyc
.venv/
.env
*.egg-info/
.pytest_cache/
.DS_Store
reports/*
!reports/.gitkeep

# data/raw: cache .pkl KHÔNG commit; CSV thô theo mã + _sources.json CÓ commit (để đối chiếu nguồn)
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/*/*
!data/raw/*/*.csv
!data/raw/*/_sources.json

# universe rộng (VN100/HOSE/HNX/UpCom): dữ liệu lớn, không commit
data/snapshots_ext/
data/export_csv/
data/raw_ext/

# cache HTML cổng tin M1 (nếu đặt ngoài data/raw/)
data/cache/news_portals/

# cache disk LLM debate (M7) — không commit
data/llm_cache/

# cache API M2–M8 (feature 011) — không commit
data/api_cache/
